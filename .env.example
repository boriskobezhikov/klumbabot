# --- Telegram user account (userbot) ---
# Get these at https://my.telegram.org -> API Development Tools.
# Needed because a plain bot can't read messages in a group it wasn't added to;
# this logs in as YOUR account (read-only listening), which is already a member
# of the chats you want to monitor.
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=klumba_userbot

# --- Notification / control bot ---
# Create a bot with @BotFather in Telegram, it gives you a token like 123456:AAExxxx
# This bot both sends you matches AND accepts the /budget, /chats, /criteria,
# /prefilter commands. Only NOTIFY_CHAT_ID may issue commands.
NOTIFY_BOT_TOKEN=123456:your_bot_token_here
# Your own chat id with that bot. Easiest way to get it:
# 1) message your new bot anything (e.g. /start)
# 2) open https://api.telegram.org/bot<NOTIFY_BOT_TOKEN>/getUpdates in a browser
# 3) copy the number at message.chat.id
NOTIFY_CHAT_ID=123456789

# --- Claude API ---
# Get a key at https://platform.claude.com (billing must be enabled)
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Search criteria: SEED VALUES ONLY ---
# These three are read exactly once — when config.json does not exist yet — to
# generate it. After that config.json is the source of truth and these are
# ignored; change the settings with /budget, /rate and /chats in Telegram.
TG_GROUP=kkklumba
BUDGET_USD=700
GEL_PER_USD=2.6

# Optional: where to keep the runtime config (default: config.json next to main.py)
# KLUMBA_CONFIG=/opt/klumba-bot/config.json
